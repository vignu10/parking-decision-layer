# Which Jev backend to use: mock | vercel | typesafe
#   mock     — deterministic offline mock (default; no key needed, never breaks a demo)
#   vercel   — Jev through Vercel AI Gateway (no TypeSafe waitlist)
#   typesafe — TypeSafe direct API (needs a TypeSafe early-access key)
JEV_PROVIDER=mock

# Vercel AI Gateway key (JEV_PROVIDER=vercel)
AI_GATEWAY_API_KEY=

# TypeSafe key (JEV_PROVIDER=typesafe)
TYPESAFE_API_KEY=

# Optional overrides
# JEV_MODEL=typesafe-ai/jev
# JEV_BASE_URL=https://ai-gateway.vercel.sh/v1/evaluate

# Hosted only: password for the site (any username). Leave unset locally.
# DEMO_PASSWORD=

# Hosted only: Redis storage. Added automatically when you connect Upstash Redis
# in Vercel → Storage. Without these, storage is in-memory (fine locally, broken on Vercel).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: also append audit events to this JSONL file (local dev only)
# AUDIT_LOG_FILE=./data/audit.jsonl
